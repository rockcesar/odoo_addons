<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_pi_network" model="ir.ui.view">
        <field name="name">payment.provider.form.pi_network</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'pi_network'">
                    <field name="pi_app_id"/>
                    <field name="pi_api_key" password="True"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
